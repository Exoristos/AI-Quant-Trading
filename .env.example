# EOD Historical Data (https://eodhistoricaldata.com/) — used for BIST EOD bars
EODHD_API_KEY=

# Optional: Federal Reserve Economic Data (https://fred.stlouisfed.org/) for macro series
FRED_API_KEY=

# TCMB EVDS 3 (https://evds3.tcmb.gov.tr/) — USD/TRY and other Turkish macro series
EVDS_API_KEY=
# Optional: only if TCMB documents a different API base (default is evds3 .../service/evds/)
# EVDS_BASE_URL=https://evds3.tcmb.gov.tr/service/evds/
